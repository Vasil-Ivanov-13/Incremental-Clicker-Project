@model List<string>
@{
    ViewData["Title"] = "Combat";
}

<h1>Combat</h1>

<ul class="list-group mb-3">
    @foreach (string line in Model)
    {
        <li class="list-group-item">@line</li>
    }
</ul>

<form asp-controller="GameScreen" asp-action="Combat" method="post" class="d-inline">
    <button type="submit" class="btn btn-warning">Fight again</button>
</form>

<a asp-controller="Player" asp-action="PlayerDetails" class="btn btn-secondary">Player details</a>
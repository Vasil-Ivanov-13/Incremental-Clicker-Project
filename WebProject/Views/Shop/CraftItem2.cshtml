@{
  
    @using (Html.BeginForm("CraftItem2", "Shop", FormMethod.Post))
    {
        <form>
            <fieldset>
                <legend>Create Armour</legend>

                <div>
                    <label>for="ItemName">Name your gear:</label>
                    <input type="text" name="ItemName" />
                </div>
                <div>
                    <label>for="HealthPoints">How much does it protect you?:</label>
                    <input type="text" name="HealthPoints" />
                </div>
                <div>
                    <button type="submit" class="btn btn-outline-primary">Craft Armour!</button>
                </div>
            </fieldset>


        </form>
    }
}

@model CraftArmourViewModel
@{
    
            
    <legend>Create Armour</legend>
     <form method="post">
    <div class="row">
    <label class="col-form-label">Name Your Armour:</label>
    </div>
    <div class="col">
    <input class="form-control" asp-for="ItemName" />
    <span asp-validation-for="ItemName" class="text-danger"></span>
    </div>
    <div class="">
    <button type="submit" class="btn btn-warning">Submit</button>
    </div>
    </form>

  
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
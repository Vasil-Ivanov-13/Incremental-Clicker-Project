@{
    @model WebProject.Data.Models.Item;
    @using (Html.BeginForm("CraftItem1", "Shop", FormMethod.Post))
    {
        
        <fieldset>
                <legend>Create Weapon</legend>

                <div>
                <label>for="ItemName">Name your weapon:</label>
                <input type="text" name="ItemName"/>
                </div>
                <div>
                    <label>for="DamagePoints">How much damage does it deal?:</label>
                    <input type="text" name="DamagePoints" />
                </div>
                <div>                    
                <button type="submit" class="btn btn-outline-primary">Craft Weapon!</button>
                </div>
        </fieldset>
        

        
    }
}

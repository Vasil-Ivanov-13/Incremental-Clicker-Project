@{
    @using (Html.BeginForm("CraftWeapon", "Shop", FormMethod.Get))
    {
        <button type="submit" class="btn btn">Craft Weapon</button>
    }
    using (Html.BeginForm("CraftArmour", "Shop", FormMethod.Get))
    {
        <button type="submit" class="btn btn">Craft Armor</button>
    }
    using (Html.BeginForm("UpgradeDamage", "Shop", FormMethod.Post))
    {
        <button type="submit" class="btn btn">Buy Damage</button>
    }
    using (Html.BeginForm("UpgradeHealth", "Shop", FormMethod.Post))
    {
        <button type="submit" class="btn btn">Buy Health</button>
    }
}

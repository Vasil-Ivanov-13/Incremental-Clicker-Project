@model ShowPlayerViewModel

<div class="card h-100">
    <div class="card-header">@Model.Name (@Model.CharacterClass)</div>
    <ul class="list-group list-group-flush">
        <li class="list-group-item">@Html.DisplayNameFor(m => m.PlayerLevel): @Model.PlayerLevel</li>
        <li class="list-group-item">@Html.DisplayNameFor(m => m.PlayerExperience): @Model.PlayerExperience</li>
        <li class="list-group-item">@Html.DisplayNameFor(m => m.PlayerGold): @Model.PlayerGold</li>
        <li class="list-group-item">@Html.DisplayNameFor(m => m.PlayerHealth): @Model.PlayerHealth</li>
        <li class="list-group-item">@Html.DisplayNameFor(m => m.PlayerStrength): @Model.PlayerStrength</li>
    </ul>
    <div class="card-footer">
        <form asp-controller="Player" asp-action="RenamePlayer" method="post" class="d-flex gap-2 mb-2">
            <input name="NewName" class="form-control form-control-sm" placeholder="New name"
                   required minlength="2" maxlength="15" />
            <button type="submit" class="btn btn-sm btn-secondary">Rename</button>
        </form>

        <form asp-controller="Player" asp-action="RemovePlayer" method="post"
              onsubmit="return confirm('Delete your character? This also removes your weapon and armour.');">
            <button type="submit" class="btn btn-sm btn-danger">Remove</button>
        </form>
    </div>
</div>
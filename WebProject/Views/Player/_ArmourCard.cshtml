@model ShowArmourViewModel

<div class="card h-100">
    <div class="card-header">Armour</div>
    <ul class="list-group list-group-flush">
        <li class="list-group-item">@Html.DisplayNameFor(m => m.Name): @Model.Name</li>
        <li class="list-group-item">@Html.DisplayNameFor(m => m.ArmourHealth): @Model.ArmourHealth</li>
    </ul>
    <div class="card-footer">
        <form asp-controller="Shop" asp-action="RemoveArmour" method="post" class="d-inline"
              onsubmit="return confirm('Remove your armour?');">
            <button type="submit" class="btn btn-sm btn-danger">Remove</button>
        </form>
    </div>
</div>